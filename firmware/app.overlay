/{
    chosen {
        zephyr,micro-ros-uart = &usart2;
    };

    zephyr,user {
        io-channels = <&adc1 2>;
    };

    aliases {
        motor-ain1 = &ain1_pin;
        motor-ain2 = &ain2_pin;
        motor-bin1 = &bin1_pin;
        motor-bin2 = &bin2_pin;
        motor-pwma = &pwma_pin;
        motor-pwmb = &pwmb_pin;
        encoder-left = &qdec_l;
        encoder-right = &qdec_r;
        imu = &bno055;
    };

    leds {
        compatible = "gpio-leds";
        ain1_pin: ain1 {
            gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
        };
        ain2_pin: ain2 {
            gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
        };
        bin1_pin: bin1 {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
        };
        bin2_pin: bin2 {
            gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
        };
    };

    gpio_keys {
        compatible = "gpio-keys";
        button1: button1 {
            gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
            label = "Button 1";
        };
    };

    pwm_motors {
        compatible = "pwm-leds";
        pwma_pin: pwma {
            pwms = <&pwm2 2 100000 PWM_POLARITY_NORMAL>;
        };
        pwmb_pin: pwmb {
            pwms = <&pwm2 3 100000 PWM_POLARITY_NORMAL>;
        };
    };
};

&usart2 {
    status = "okay";
    current-speed = <115200>;
};

&timers3 {
    status = "okay";

    pwm {
        status = "disabled";
    };

    qdec_l: encoder_left {
        compatible = "st,stm32-qdec";
        status = "okay";
        pinctrl-0 = <&tim3_ch1_pa6 &tim3_ch2_pa7>;
        pinctrl-names = "default";
        st,counts-per-revolution = <660>;
        label = "Encoder do silnik lewy";
    };
};
&timers4 {
    status = "okay";

    pwm {
        status = "disabled";
    };
    qdec_r: encoder_right {
        compatible = "st,stm32-qdec";
        status = "okay";
        pinctrl-0 = <&tim4_ch1_pb6 &tim4_ch2_pb7>;
        pinctrl-names = "default";
        st,counts-per-revolution = <660>;
        label = "Encoder do silnik prawy";
    };
};


&pwm2 {
    status = "okay";
    pinctrl-0 = <&tim2_ch2_pa1 &tim2_ch3_pb10>;
    pinctrl-names = "default";
};

&i2c1 {

    status = "okay";

    bno055: bno055@28 {
        compatible = "i2c-device";
        status = "okay";
        reg = <0x29>;
    };

};

&spi1 {
    status = "disabled";
};

    &pinctrl {
   
    tim3_ch1_pa6: tim3_ch1_pa6 {
        bias-pull-up;
    };
    tim3_ch2_pa7: tim3_ch2_pa7 {
        bias-pull-up;
    };


    tim4_ch1_pb6: tim4_ch1_pb6 {
        bias-pull-up;
    };
    tim4_ch2_pb7: tim4_ch2_pb7 {
        bias-pull-up;
    };

    adc1_in2_pc1: adc1_in2_pc1 {
        pinmux = <STM32_PINMUX('C', 1, ANALOG)>;
    };
};
&adc1 {
    status = "okay";
    pinctrl-0 = <&adc1_in2_pc1>;
    pinctrl-names = "default";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 640)>;
        zephyr,resolution = <12>;
    };
};